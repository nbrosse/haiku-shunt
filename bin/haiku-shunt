#!/usr/bin/env python3
"""haiku-shunt: what the hooks did, and whether the install is sound.

Subcommands:
  report   read the event log: how often each hook fired, why, and how big the
           denied files were
  doctor   check the installation and print the break-even file size

What the shunt actually saves is not computed here: run the same task with and
without the plugin (bench/ab.sh) and compare what Claude Code itself reports.
"""
import argparse, glob, json, os, sys
from datetime import datetime, timedelta, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CFG = json.load(open(os.path.join(ROOT, "config", "defaults.json")))
PRICE = CFG["pricing_usd_per_mtok"]
# The main session and subagents do not use the same cache TTL: 1h (2x) for
# the parent, 5m (1.25x) for the worker. See usage.cache_creation in transcripts.
KW_PARENT = PRICE["parent_cache_write_multiplier"]
KW_WORKER = PRICE["worker_cache_write_multiplier"]
KR = PRICE["cache_read_multiplier"]

# Lower bounds, in lines reaching the model. Deny needs > min_lines, so the
# first bucket only fills from byte-size denies or a lowered threshold.
BUCKETS = [(0, "<350"), (350, "350-500"), (500, "500-1000"),
           (1000, "1000-2000"), (2000, "2000+")]


def log_dir(create=False):
    """Read side: find the dir the hooks write to. `create=True` mirrors what
    hooks/lib/common.sh does on first run -- only `doctor` asks for that, so a
    plain `report` never leaves a directory behind."""
    for d in (os.environ.get("SHUNT_LOG_DIR"),
              (os.environ.get("HAIKU_SHUNT_PLUGIN_DATA") or "") + "/metrics",
              (os.environ.get("CLAUDE_PLUGIN_DATA") or "") + "/metrics",
              (os.environ.get("CLAUDE_PROJECT_DIR") or "") + "/.haiku-shunt/metrics",
              os.path.expanduser(os.environ.get("XDG_STATE_HOME", "~/.local/state"))
              + "/haiku-shunt/metrics"):
        if not d or d == "/metrics":
            continue
        if os.path.isdir(d):
            return d
        if create:
            try:
                os.makedirs(d, exist_ok=True)
                os.chmod(d, 0o700)
                return d
            except OSError:
                continue
    return None


def load_events(since_days=None):
    d = log_dir()
    if not d:
        return []
    cutoff = None
    if since_days is not None:
        cutoff = datetime.now(timezone.utc) - timedelta(days=since_days)
    out = []
    for f in sorted(glob.glob(os.path.join(d, "events-*.jsonl"))):
        for line in open(f, errors="replace"):
            line = line.strip()
            if not line:
                continue
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if cutoff:
                try:
                    if datetime.fromisoformat(r["ts"].replace("Z", "+00:00")) < cutoff:
                        continue
                except (KeyError, ValueError):
                    pass
            out.append(r)
    return out


def rate(model, key):
    m = PRICE["models"].get(model)
    if not m:
        for k, v in PRICE["models"].items():
            if model and model.startswith(k):
                m = v
                break
    return (m or PRICE["models"][PRICE["default_parent"]])[key]


def parent_factor(turns, cache_hit):
    """Cost multiplier applied to tokens that enter the parent context.

    Content is cache-written once (2x: the main session uses the 1h TTL), then
    re-sent on every later turn -- at the cache-read rate when it hits (0.10x)
    and at full rate when it does not. This second term is where the saving
    actually comes from.
    """
    mu = KR * cache_hit + 1.0 * (1.0 - cache_hit)
    return KW_PARENT + mu * turns


def breakeven_tokens(parent, turns, cache_hit, floor, worker_out=500):
    """Smallest file worth shunting: below this, the worker's fixed cost
    exceeds what keeping the file out of the parent saves."""
    p_in = rate(parent, "input")
    h_in = rate(PRICE["default_worker"], "input")
    h_out = rate(PRICE["default_worker"], "output")
    denom = p_in * parent_factor(turns, cache_hit) - KW_WORKER * h_in
    if denom <= 0:
        return None
    return (floor * KW_WORKER * h_in + worker_out * h_out) / denom


def deny_lines(h):
    """Lines a denied command would have put in front of the model: for Bash,
    what reached stdout (a `tail -n +K` or `| head` shrinks it); for Read, the
    file. The largest operand is the one that tripped."""
    return max((p.get("effective_lines", p.get("lines")) or 0
                for p in (h.get("paths") or []) if p.get("exists")), default=0)


def bucket(n):
    return [label for lo, label in BUCKETS if n >= lo][-1]


def cmd_report(a):
    ev = load_events(a.since)
    hooks = [e for e in ev if e.get("event") == "hook_decision"]
    denies = [h for h in hooks if h.get("decision") == "deny"]
    reasons = {}
    for h in hooks:
        k = f"{h.get('decision')}/{h.get('reason_code')}"
        reasons[k] = reasons.get(k, 0) + 1
    sizes = {label: 0 for _, label in BUCKETS}
    for h in denies:
        sizes[bucket(deny_lines(h))] += 1

    if a.format == "json":
        print(json.dumps({"hook_calls": len(hooks), "denies": len(denies),
                          "reasons": reasons, "deny_size_buckets": sizes}, indent=2))
        return 0
    if not hooks:
        print("No events yet. Log dir: " + (log_dir() or "<none found>"))
        return 0

    print(f"\nhaiku-shunt report      log: {log_dir()}\n")
    print("DECISIONS")
    print(f"  {'hook':<14}{'fired':>7}{'deny':>7}{'none':>7}{'deny%':>8}{'p50 ms':>9}{'p95 ms':>9}")
    for hk in sorted({h.get("hook") for h in hooks if h.get("hook")}):
        rows = [h for h in hooks if h.get("hook") == hk]
        dn = sum(1 for h in rows if h.get("decision") == "deny")
        lat = sorted(h.get("latency_ms") or 0 for h in rows)
        p50 = lat[len(lat) // 2] if lat else 0
        p95 = lat[min(len(lat) - 1, int(len(lat) * 0.95))] if lat else 0
        print(f"  {hk:<14}{len(rows):>7}{dn:>7}{len(rows)-dn:>7}"
              f"{100*dn/max(1,len(rows)):>7.1f}%{p50:>9}{p95:>9}")

    print("\nWHY")
    for k, n in sorted(reasons.items(), key=lambda kv: -kv[1])[:10]:
        dec, rc = k.split("/", 1)
        print(f"  {dec:<6} {rc:<24}{n:>6}")

    # The threshold in force is the one the hook logged (SHUNT_MIN_LINES may
    # have overridden the config), not the config default.
    thr = next((h["threshold_lines"] for h in reversed(hooks) if h.get("threshold_lines")),
               CFG["thresholds"]["min_lines"])
    print(f"\nDENIED SIZES  lines that would have reached the model (threshold {thr})")
    for label, n in sizes.items():
        print(f"  {label:<12}{n:>6}  {'#' * min(n, 50)}")
    print("\n  A threshold change only affects the denies in the buckets it crosses.")
    print("  What they cost or save is measured by A/B: bash bench/ab.sh --arm ...\n")
    return 0


def cmd_doctor(a):
    ok = True
    def chk(label, good, detail=""):
        nonlocal ok
        print(f"  [{'ok' if good else 'FAIL'}] {label}" + (f"  {detail}" if detail else ""))
        ok = ok and good

    print("\nhaiku-shunt doctor\n")
    print("environment")
    chk("jq present", os.system("command -v jq >/dev/null 2>&1") == 0)
    chk("python3 >= 3.8", sys.version_info >= (3, 8), sys.version.split()[0])
    chk("flock present", os.system("command -v flock >/dev/null 2>&1") == 0)
    # Create it if the hooks have not run yet: an uncreated dir is not a fault,
    # and reporting FAIL on a clean install sends people hunting for a bug.
    d = log_dir(create=True)
    chk("log dir writable", bool(d) and os.access(d, os.W_OK), d or "not creatable")
    if d:
        try:
            import subprocess
            fs = subprocess.run(["stat", "-f", "-c", "%T", d], capture_output=True,
                                text=True).stdout.strip()
            if fs in ("nfs", "cifs", "fuseblk"):
                print(f"  [warn] log dir is on {fs}; set SHUNT_LOG_LOCK=1 "
                      "(O_APPEND atomicity is not guaranteed there)")
        except Exception:
            pass

    print("\nhooks")
    for h in ("read-guard.sh", "bash-guard.sh"):
        p = os.path.join(ROOT, "hooks", h)
        chk(h, os.access(p, os.X_OK))

    est = CFG["estimation"]
    floor, turns, hit = est["worker_floor_tokens"], est["assumed_turns_remaining"], \
        est["assumed_cache_hit_rate"]
    print(f"\nbreak-even (assumed: worker floor {floor:,} tok, R={turns}, h={hit})")
    for parent in ("claude-sonnet-5", "claude-opus-5"):
        be = breakeven_tokens(parent, turns, hit, floor)
        print(f"  break-even vs {parent:<18} {be:>8,.0f} tokens  (~{be/13:>5,.0f} lines)")
    cur = CFG["thresholds"]["min_lines"]
    be_s = breakeven_tokens("claude-sonnet-5", turns, hit, floor)
    if be_s and cur * 13 < be_s:
        print(f"\n  NOTE: SHUNT_MIN_LINES={cur} is below break-even for a Sonnet parent.")
        print(f"        Consider SHUNT_MIN_LINES={int(be_s/13)} on Sonnet; "
              f"{cur} suits an Opus parent.")
    print("  An order of magnitude, not a measurement: validate with bench/ab.sh --arm.")

    print("\nneeds one live delegation to confirm")
    ev = load_events()
    ev_agents = {e.get("agent_type") for e in ev
                 if e.get("event") == "hook_decision" and e.get("agent_type")}
    ours = {a for a in ev_agents if a.split(":")[-1] in CFG["policy"]["worker_agents"]}
    if ours:
        print(f"  [ok]   recursion guard has fired for: {', '.join(sorted(ours))}")
    else:
        print("  [....] agent_type has not yet been seen from one of our workers.")
        print("         Expect the NAMESPACED form, e.g. 'haiku-shunt:bulk-reader' -")
        print("         plugin agents are not delivered under their bare name.")
    print("  [....] is the worker really on Haiku? `claude plugin validate` does NOT")
    print("         check the model: field. After a delegation, check message.model in")
    print("         ~/.claude/projects/<project>/<session>/subagents/agent-*.jsonl.")
    print("         A claude-haiku-* entry in modelUsage is NOT proof: Claude Code")
    print("         makes a small Haiku call of its own in every session.\n")
    return 0 if ok else 1


def main():
    p = argparse.ArgumentParser(prog="haiku-shunt")
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("report", help="hook decisions and denied sizes from the event log")
    r.add_argument("--since", type=float, default=None, metavar="DAYS")
    r.add_argument("--format", choices=["table", "json"], default="table")
    r.set_defaults(func=cmd_report)

    d = sub.add_parser("doctor", help="check install and print the break-even size")
    d.set_defaults(func=cmd_doctor)

    a = p.parse_args()
    sys.exit(a.func(a))


if __name__ == "__main__":
    main()
